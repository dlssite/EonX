
# ─────────────────────────────────────────
# POSTGRES CONTAINER
# ─────────────────────────────────────────

# Must match DATABASE_URI credentials in .env.production
POSTGRES_USER=eonrisia
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=eonrisia_db

# ─────────────────────────────────────────
# APP CONTAINER IMAGE
# ─────────────────────────────────────────

# Docker image to pull and run (set by CI/CD)
IMAGE_TAG=ghcr.io/eonrisia/eonrisia-web:latest

# ─────────────────────────────────────────
# PAYLOAD MEDIA
# ─────────────────────────────────────────

# Absolute path inside the container where uploaded media files are stored.
# Must match the volume mount target in docker-compose.yml (/app/public/media).
# This ensures Payload serves files as static assets (/media/file.png) instead
# of streaming them through the API (/api/media/file/file.png).
PAYLOAD_MEDIA_DIR=/app/public/media

# ─────────────────────────────────────────
# CADDY
# ─────────────────────────────────────────

# Public domain Caddy provisions TLS for
CADDY_DOMAIN=eonrisia.org
