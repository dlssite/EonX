
# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────

# PostgreSQL connection string
# Local dev (native):  postgresql://eonrisia:password@localhost:5432/eonrisia_db
# Docker (in-network): postgresql://eonrisia:password@postgres:5432/eonrisia_db
DATABASE_URI=postgresql://eonrisia:your_db_password@localhost:5432/eonrisia_db

# ─────────────────────────────────────────
# PAYLOAD CMS
# ─────────────────────────────────────────

# Random secret for signing Payload auth tokens (min 32 chars)
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=your_payload_secret_min_32_chars

# ─────────────────────────────────────────
# SITE
# ─────────────────────────────────────────

# Public base URL — no trailing slash
# Local: http://localhost:3000
# Prod:  https://eonrisia.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Absolute URL where Payload serves media
NEXT_PUBLIC_MEDIA_URL=http://localhost:3000/media

# ─────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────

# Resend API key for transactional email
RESEND_API_KEY=re_your_resend_api_key

# Email that receives form submission notifications
NOTIFY_EMAIL=team@eonrisia.org

# ─────────────────────────────────────────
# ISR REVALIDATION
# ─────────────────────────────────────────

# Authenticates the /api/revalidate webhook
# Generate: openssl rand -hex 32
REVALIDATION_SECRET=your_revalidation_secret
